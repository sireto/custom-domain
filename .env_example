SAAS_UPSTREAM=example.com:443
API_KEY=0df05a6c-d4c6-4ee4-a55d-de1409e82cee
# Authoritative database. SQLite file by default; PostgreSQL for production.
DATABASE_URL=sqlite:///data/custom_domain.db
# DATABASE_URL=postgresql+psycopg://custom_domain:change-me@db:5432/custom_domain

# Legacy /domains API. Set to false once hostnames are imported; the edge
# reconciler then derives the Caddy configuration from the database.
ENABLE_LEGACY_API=true
# EDGE_RECONCILE_ENABLED defaults to the opposite of ENABLE_LEGACY_API.
# EDGE_RECONCILE_INTERVAL=30
# ACME_EMAIL=ops@example.com

# Certificate storage for Caddy: "file" (single edge, https_data volume) or
# "redis" (required when more than one edge instance runs).
CADDY_STORAGE=file
# CADDY_REDIS_ADDRESS=redis:6379
# CADDY_REDIS_PASSWORD=change-me
# CADDY_REDIS_TLS=true
# CADDY_REDIS_ENCRYPTION_KEY=at-least-32-characters-of-random-secret

# DNS verification worker (runs in the API process).
# DNS_WORKER_ENABLED=true
# DNS_WORKER_INTERVAL=10
# DNS_RESOLVERS=1.1.1.1,8.8.8.8   # default: the system resolvers
# DNS_TIMEOUT=5

# On-demand TLS and the readiness probe (docs/tls-readiness.md).
# EDGE_ASK_URL=http://localhost:9000/internal/tls/ask
# EDGE_PROBE_ADDRESS=      # host:port when the edge's public address is not reachable from the container
# EDGE_PROBE_CA_FILE=      # CA bundle for a private CA (development/staging)

# Routing (docs/edge-routing.md). Required when ENABLE_LEGACY_API=false: the
# edge signs every proxied request. "<key id>:<secret of 32+ chars>,..."; the
# first key signs, the rest are accepted during rotation.
# EDGE_ASSERTION_KEYS=1:replace-with-python-secrets-token_urlsafe-48
# EDGE_ASSERTION_TTL=60
# EDGE_ASSERT_UPSTREAM=localhost:9000
