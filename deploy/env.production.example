# Copy to deploy/.env and fill in. Never commit the filled file. Compose reads
# deploy/.env automatically for ${...} substitution; the api and worker load all of
# it, the edge only the settings listed for it in compose.production.yml.
DATABASE_URL=postgresql+psycopg://custom_domain:CHANGE-ME@db:5432/custom_domain
POSTGRES_PASSWORD=CHANGE-ME
ACME_EMAIL=ops@example.net

# The edge's own DNS name (the default CNAME target; certified and serving the portal
# from the first start). Point it at this server.
EDGE_HOSTNAME=edge.example.net

# Operator portal at /portal of the management API (12+ characters; unset disables it)
PORTAL_PASSWORD=CHANGE-ME-12-CHARS-OR-MORE
# Addresses or networks that may open https://<edge name>/portal through the edge.
# Empty: reachable only over an SSH tunnel to 127.0.0.1:9000.
# PORTAL_ALLOWED_IPS=203.0.113.9,198.51.100.0/24

# Serve the v1 API at https://<EDGE_HOSTNAME>/v1 for applications (credential-authenticated).
# false: only on 127.0.0.1:9000 of the host; put your own reverse proxy in front.
PUBLIC_API=true

# Edge signing and edge-to-API trust
EDGE_ASSERTION_KEYS=1:CHANGE-ME-32-CHARS-OR-MORE
EDGE_TOKEN=CHANGE-ME-32-CHARS-OR-MORE

# Certificate storage (shared by all edge containers)
CADDY_REDIS_PASSWORD=CHANGE-ME
CADDY_REDIS_ENCRYPTION_KEY=CHANGE-ME-32-CHARS-OR-MORE

# Optional
# At most this many live domains across all applications; unset for no limit.
# Existing domains are never affected; new registrations get domain_limit_reached.
# MAX_DOMAINS=10000
# At most this many v1 API requests per credential in any 60 seconds; unset for no limit.
# V1_REQUESTS_PER_MINUTE=600
# DNS_RESOLVERS=1.1.1.1,8.8.8.8
# The providerId of your Domain Connect template, if you publish one (serviceId defaults to hostname).
# DOMAIN_CONNECT_PROVIDER_ID=
# Where setup.guide_url points; {provider} becomes the provider id or "generic".
# DNS_GUIDE_URL=https://docs.example.com/dns/{provider}/
# EDGE_PROBE_ADDRESS=edge:443

# Optional: image to run (defaults to ghcr.io/sireto/custom-domain:latest). The
# installer writes <name>:<version>, or <name>:<version>@sha256:<digest> when
# CUSTOM_DOMAIN_IMAGE_DIGEST pins it (docs/deployment.md, "Pinning the image by digest").
# CUSTOM_DOMAIN_IMAGE=ghcr.io/sireto/custom-domain:latest
