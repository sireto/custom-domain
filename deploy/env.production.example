# Copy to deploy/.env and fill in. Never commit the filled file. Compose reads
# deploy/.env automatically for ${...} substitution and the services load it too.
DATABASE_URL=postgresql+psycopg://custom_domain:CHANGE-ME@db:5432/custom_domain
POSTGRES_PASSWORD=CHANGE-ME
ACME_EMAIL=ops@example.net

# Edge signing and edge-to-API trust
EDGE_ASSERTION_KEYS=1:CHANGE-ME-32-CHARS-OR-MORE
EDGE_TOKEN=CHANGE-ME-32-CHARS-OR-MORE

# Certificate storage (shared by all edge containers)
CADDY_REDIS_PASSWORD=CHANGE-ME
CADDY_REDIS_ENCRYPTION_KEY=CHANGE-ME-32-CHARS-OR-MORE

# Optional
# DNS_RESOLVERS=1.1.1.1,8.8.8.8
# EDGE_PROBE_ADDRESS=edge:443

# Optional: image tag to run (defaults to ghcr.io/sireto/custom-domain:latest)
# CUSTOM_DOMAIN_IMAGE=ghcr.io/sireto/custom-domain:latest
